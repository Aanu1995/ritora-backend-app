[Unit]
Description=Ritora Backend API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/ritora/backend/current
EnvironmentFile=/etc/ritora/backend.env
ExecStart=/usr/bin/npm run start:prod
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
SyslogIdentifier=ritora-backend

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/ritora/backend

[Install]
WantedBy=multi-user.target
