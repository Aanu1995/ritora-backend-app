NODE_ENV=development
API_PORT=3001
LOG_LEVEL=debug

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ritora
DATABASE_USER=postgres
DATABASE_PASSWORD=6548
DATABASE_SSL=false

# CORS
CORS_ORIGINS=http://localhost:3000

# JWT
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=ritora
JWT_AUDIENCE=ritora-web

# Cookie (refresh token) — COOKIE_DOMAIN intentionally blank for local dev (host-only cookie)
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_REFRESH_NAME=ritora_refresh

# Security
BCRYPT_SALT_ROUNDS=12
EMAIL_VERIFICATION_EXPIRY=24h
PASSWORD_RESET_EXPIRY=1h

# Mail (Mailpit for local dev: localhost:1025, web UI at localhost:8025)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@ritora.com

# Frontend
FRONTEND_URL=http://localhost:3000

# Swagger
SWAGGER_ENABLED=true

# Legal versioning (source of truth for consent records)
LEGAL_TERMS_VERSION=1.0.0
LEGAL_PRIVACY_VERSION=1.0.0
