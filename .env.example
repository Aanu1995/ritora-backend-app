NODE_ENV=development
API_PORT=3001
LOG_LEVEL=debug

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ritora
DATABASE_USER=postgres
DATABASE_PASSWORD=6548
DATABASE_SSL=false
DATABASE_LOGGING=false

# CORS
CORS_ORIGINS=http://localhost:3000

# JWT
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=ritora
JWT_AUDIENCE=ritora-web

# Cookie (refresh token) — COOKIE_DOMAIN intentionally blank for local dev (host-only cookie)
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_REFRESH_NAME=ritora_refresh

# Security
BCRYPT_SALT_ROUNDS=12
EMAIL_VERIFICATION_EXPIRY=24h
PASSWORD_RESET_EXPIRY=1h

# Mail (Resend Email API)
# Use a real Resend API key. For local testing you can start with
# MAIL_FROM=auth@auth.getritora.com once your Resend sending subdomain is verified.
RESEND_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Recommended: use low reasoning for core product extraction, and none for optional web enrichment.
OPENAI_PRODUCT_DISCOVERY_REASONING_EFFORT=low
OPENAI_PRODUCT_DISCOVERY_WEB_REASONING_EFFORT=none
MAIL_FROM=auth@auth.getritora.com

# Sensitive Skin Profile field encryption
# Production requires a stable secret with at least 32 characters.
SKIN_PROFILE_FIELD_ENCRYPTION_KEY=
SKIN_PROFILE_FIELD_ENCRYPTION_KEY_ID=primary

# Product media (AWS S3 + private CloudFront)
AWS_REGION=eu-west-1
# Set these per environment, e.g. development -> ritora-dev-product-media
PRODUCT_MEDIA_BUCKET=
PRODUCT_MEDIA_CLOUDFRONT_URL=
PRODUCT_MEDIA_CLOUDFRONT_KEY_PAIR_ID=
PRODUCT_MEDIA_CLOUDFRONT_PRIVATE_KEY=
PRODUCT_MEDIA_S3_KMS_KEY_ID=
PRODUCT_EXTRACTION_IMAGE_MAX_DIMENSION=2400
PRODUCT_EXTRACTION_IMAGE_WEBP_QUALITY=90

# Skin Journal media
# Production requires S3 + private CloudFront. Local development can leave these
# blank to use the code-level local fallback.
SKIN_JOURNAL_MEDIA_BUCKET=
SKIN_JOURNAL_MEDIA_CLOUDFRONT_URL=
SKIN_JOURNAL_MEDIA_CLOUDFRONT_KEY_PAIR_ID=
SKIN_JOURNAL_MEDIA_CLOUDFRONT_PRIVATE_KEY=
SKIN_JOURNAL_S3_KMS_KEY_ID=

# Web app
WEB_APP_URL=http://localhost:3000

# Swagger
SWAGGER_ENABLED=false

# Legal versioning (source of truth for consent records)
LEGAL_TERMS_VERSION=1.0.0
LEGAL_PRIVACY_VERSION=1.0.0
