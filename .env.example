NODE_ENV=development
API_PORT=3001
LOG_LEVEL=debug

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ritora
DATABASE_USER=postgres
DATABASE_PASSWORD=6548
DATABASE_SSL=false
DATABASE_LOGGING=false

# CORS
CORS_ORIGINS=http://localhost:3000

# JWT
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=ritora
JWT_AUDIENCE=ritora-web

# Cookie (refresh token) — COOKIE_DOMAIN intentionally blank for local dev (host-only cookie)
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_REFRESH_NAME=ritora_refresh

# Security
BCRYPT_SALT_ROUNDS=12
EMAIL_VERIFICATION_EXPIRY=24h
PASSWORD_RESET_EXPIRY=1h

# Mail (Resend Email API)
# Use a real Resend API key. For local testing you can start with
# MAIL_FROM=auth@auth.getritora.com once your Resend sending subdomain is verified.
RESEND_API_KEY=
OPENAI_API_KEY=
OPENAI_PRODUCT_DISCOVERY_MODEL=gpt-5.5
OPENAI_INGREDIENT_EXPLANATION_MODEL=gpt-5.5
MAIL_FROM=auth@auth.getritora.com

# Product media (AWS S3 + private CloudFront)
AWS_REGION=eu-west-1
# Set these per environment, e.g. development -> ritora-dev-product-media
PRODUCT_MEDIA_BUCKET=
PRODUCT_MEDIA_CLOUDFRONT_URL=
PRODUCT_MEDIA_CLOUDFRONT_KEY_PAIR_ID=
PRODUCT_MEDIA_CLOUDFRONT_PRIVATE_KEY=
PRODUCT_MEDIA_S3_KMS_KEY_ID=
PRODUCT_MEDIA_SIGNED_URL_TTL_SECONDS=3600
PRODUCT_MEDIA_PROCESSED_MAX_DIMENSION=1600
PRODUCT_MEDIA_WEBP_QUALITY=82
PRODUCT_EXTRACTION_IMAGE_MAX_DIMENSION=2400
PRODUCT_EXTRACTION_IMAGE_WEBP_QUALITY=90

# Web app
WEB_APP_URL=http://localhost:3000

# Swagger
SWAGGER_ENABLED=false

# Legal versioning (source of truth for consent records)
LEGAL_TERMS_VERSION=1.0.0
LEGAL_PRIVACY_VERSION=1.0.0
