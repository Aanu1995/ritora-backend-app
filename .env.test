NODE_ENV=test
API_PORT=3002
LOG_LEVEL=error

# Database — use ritora_test
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ritora_test
DATABASE_USER=postgres
# Intentionally omitted so local runs can inherit the real password from .env
DATABASE_SSL=false

# CORS
CORS_ORIGINS=http://localhost:3000

# JWT
JWT_SECRET=test-jwt-secret-long-enough-for-validation
JWT_REFRESH_SECRET=test-jwt-refresh-secret-long-enough
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=ritora
JWT_AUDIENCE=ritora-web

# Cookie
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_REFRESH_NAME=ritora_refresh

# Security — low bcrypt rounds for fast tests
BCRYPT_SALT_ROUNDS=4
EMAIL_VERIFICATION_EXPIRY=24h
PASSWORD_RESET_EXPIRY=1h

# Mail (overridden by MockMailService in tests)
RESEND_API_KEY=re_test_mock
MAIL_FROM=onboarding@resend.dev

# Skin Journal test defaults
OPENAI_API_KEY=
OPENAI_MODEL=
SKIN_JOURNAL_MEDIA_BUCKET=
SKIN_JOURNAL_MEDIA_CLOUDFRONT_URL=
SKIN_JOURNAL_MEDIA_CLOUDFRONT_KEY_PAIR_ID=
SKIN_JOURNAL_MEDIA_CLOUDFRONT_PRIVATE_KEY=
SKIN_JOURNAL_S3_KMS_KEY_ID=

# Frontend
FRONTEND_URL=http://localhost:3000

# Swagger
SWAGGER_ENABLED=false

# Legal
LEGAL_TERMS_VERSION=1.0.0
LEGAL_PRIVACY_VERSION=1.0.0
