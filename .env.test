NODE_ENV=test
API_PORT=3002
LOG_LEVEL=error
OTEL_ENABLED=false
OTEL_SERVICE_NAME=ritora-backend-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Database — use ritora_test
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ritora_test
DATABASE_USER=postgres
# Intentionally omitted so local runs can inherit the real password from .env
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_LOGGING=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false
# Destructive e2e cleanup is disabled by default. Export this as true only
# when DATABASE_NAME is a disposable test database.
RITORA_ALLOW_DESTRUCTIVE_TEST_DB_RESET=false

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Admin dashboard
ADMIN_ROOT_EMAIL=owner@ritora.app
ADMIN_ROOT_SETUP_TOKEN_HASH=ffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb
ADMIN_ROOT_SETUP_EXPIRY=24h
ADMIN_COOKIE_REFRESH_NAME=ritora_admin_refresh
ADMIN_INVITATION_EXPIRY=7d
ADMIN_WEB_APP_URL=http://localhost:3002

# JWT
JWT_SECRET=test-jwt-secret-long-enough-for-validation
JWT_REFRESH_SECRET=test-jwt-refresh-secret-long-enough
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=ritora
JWT_AUDIENCE=ritora-web

# Cookie
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_REFRESH_NAME=ritora_refresh

# Security — low bcrypt rounds for fast tests
BCRYPT_SALT_ROUNDS=4
EMAIL_VERIFICATION_EXPIRY=24h
PASSWORD_RESET_EXPIRY=1h
GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_ID_TOKEN_AUDIENCES=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback
APPLE_CLIENT_ID=com.ritora.test
APPLE_TEAM_ID=TEAM123456
APPLE_KEY_ID=KEY1234567
APPLE_PRIVATE_KEY=-----BEGIN EC PRIVATE KEY-----\nMHcCAQEEIGWmUqh14yuHsjdjEfnA94pCssmohC41yFdWXGwwc/UQoAoGCCqGSM49\nAwEHoUQDQgAEBMnCpQo4OcuJ3FJKqO3JIVINbnc5hgYiLK0JXxCawjiR+YcJT+jg\nRL5LmNoTe2QlK4fNTuAUbuUqmWZfz2HUvw==\n-----END EC PRIVATE KEY-----\n
APPLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/apple/callback

# Mail (overridden by MockMailService in tests)
RESEND_API_KEY=re_test_mock
MAIL_FROM=onboarding@resend.dev
SUPPORT_EMAIL=support@getritora.com

# Skin Journal test defaults
OPENAI_API_KEY=
OPENAI_MODEL=
CATALOGUE_AI_MODEL=gpt-5.5
INGREDIENT_ANALYSIS_AI_MODEL=gpt-5.5
INGREDIENT_EXPLANATION_AI_MODEL=gpt-5.5
INGREDIENT_TRANSLATION_AI_MODEL=gpt-5.5
INGREDIENT_TRANSLATION_SOURCE_LANGUAGE=en
