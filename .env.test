COMMUNITY_MODERATION_AI_MODEL=
INGREDIENT_ANALYSIS_QUEUE_DRIVER=database
INGREDIENT_ANALYSIS_SQS_QUEUE_URL=
INGREDIENT_ANALYSIS_SQS_DLQ_URL=
