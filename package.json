{
  "name": "ritora-backend-app",
  "version": "0.0.1",
  "description": "Ritora backend API — AI-powered skincare decision support platform",
  "author": "Aanu",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:run": "npm run typeorm -- migration:run -d src/database/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/database/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate -d src/database/data-source.ts",
    "start:dev:all": "ts-node -r tsconfig-paths/register src/scripts/start-dev-all.ts",
    "start:dev:all:evaluate": "npm run skin-journal:analysis-evaluate:dev; npm run start:dev:all",
    "skin-journal:analysis-worker:dev": "ts-node -r tsconfig-paths/register src/scripts/start-skin-journal-analysis-worker.ts",
    "skin-journal:insight-worker:dev": "ts-node -r tsconfig-paths/register src/scripts/start-skin-journal-insight-worker.ts",
    "smart-picks:generation-worker:dev": "ts-node -r tsconfig-paths/register src/scripts/start-smart-picks-generation-worker.ts",
    "account-deletion-worker:dev": "ts-node -r tsconfig-paths/register src/scripts/start-account-deletion-worker.ts",
    "smart-picks:evaluate:dev": "ts-node -r tsconfig-paths/register src/scripts/evaluate-smart-picks.ts",
    "suggestions:evaluate:dev": "ts-node -r tsconfig-paths/register src/scripts/evaluate-todays-suggestion.ts",
    "smart-picks:seed-review:dev": "ts-node -r tsconfig-paths/register src/scripts/seed-smart-picks-review.ts",
    "smart-picks:monitoring-report:dev": "ts-node -r tsconfig-paths/register src/scripts/report-smart-picks-monitoring.ts",
    "skin-journal:analysis-evaluate:dev": "ts-node -r tsconfig-paths/register src/scripts/evaluate-skin-journal-analysis.ts",
    "skin-journal:analysis-worker": "npm run build && node dist/scripts/start-skin-journal-analysis-worker.js",
    "skin-journal:insight-worker": "npm run build && node dist/scripts/start-skin-journal-insight-worker.js",
    "smart-picks:generation-worker": "npm run build && node dist/scripts/start-smart-picks-generation-worker.js",
    "account-deletion-worker": "npm run build && node dist/scripts/start-account-deletion-worker.js",
    "smart-picks:evaluate": "npm run build && node dist/scripts/evaluate-smart-picks.js",
    "suggestions:evaluate": "npm run build && node dist/scripts/evaluate-todays-suggestion.js",
    "smart-picks:seed-review": "npm run build && node dist/scripts/seed-smart-picks-review.js",
    "smart-picks:monitoring-report": "npm run build && node dist/scripts/report-smart-picks-monitoring.js",
    "skin-journal:analysis-evaluate": "npm run build && node dist/scripts/evaluate-skin-journal-analysis.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1033.0",
    "@aws-sdk/client-scheduler": "^3.1047.0",
    "@aws-sdk/client-sqs": "^3.1040.0",
    "@aws-sdk/cloudfront-signer": "^3.1031.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.7",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.218.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dayjs": "^1.11.20",
    "handlebars": "^4.7.9",
    "he": "^1.2.0",
    "helmet": "^8.1.0",
    "joi": "^18.1.2",
    "jsonwebtoken": "^9.0.3",
    "nestjs-pino": "^4.6.1",
    "passport": "^0.7.0",
    "passport-apple": "^2.0.2",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.12.0",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.28",
    "ulid": "^3.0.2",
    "web-push": "^3.6.7",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/he": "^1.2.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.7",
    "@types/passport-apple": "^2.0.3",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true
          },
          "diagnostics": {
            "ignoreCodes": [
              151002
            ]
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!uuid/)"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.spec.ts",
      "!**/*.spec-utils.ts",
      "!**/__tests__/**",
      "!main.ts",
      "!**/*.module.ts",
      "!**/dto/**",
      "!**/entities/**",
      "!**/seed/**",
      "!**/*.seed.ts",
      "!scripts/**",
      "!database/**",
      "!config/**"
    ],
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "functions": 80,
        "lines": 80
      }
    },
    "testEnvironment": "node"
  }
}
