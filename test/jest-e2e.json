{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "maxWorkers": 1,
  "testTimeout": 30000,
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": { "allowJs": true },
        "diagnostics": { "ignoreCodes": [151002] }
      }
    ]
  },
  "transformIgnorePatterns": ["/node_modules/(?!uuid/)"],
  "setupFiles": ["./env-setup.ts"]
}
